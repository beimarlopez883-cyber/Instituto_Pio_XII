lor: rgb(218, 221, 225) rgb(14, 31, 91) rgb(14, 31, 91) rgb(217, 223, 234);=
 border-style: solid; border-width: 1px; color: rgb(255, 255, 255); padding=
: 2px 15px 3px; text-align: center; }

