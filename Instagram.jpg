h4, h5, h6 { font-size: 12px; }

p { margin: 1em 0px; }

b, strong { font-weight: 600; }

a { color: rgb(56, 88, 152); cursor: pointer; text-decoration: none; }

button { margin: 0px; }

a:hover { text-decoration: underline; }

img { border: 0px; }

td, td.label { text-align: left; }

